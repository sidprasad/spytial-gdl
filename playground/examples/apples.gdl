%%{
@group(selector=contains, name='Bag')
@hideAtom(selector=Bag)
@hideField(field=contains)

%% Style Apples and Cherries to be different.
@atomStyle(selector=Apple, borderStyle(color=green), iconStyle(path='lucide:apple', placement=full, opacity=0.2))
@atomStyle(selector=Cherry, borderStyle(color=red), iconStyle(path='lucide:cherry', placement=full, opacity=0.2))
}%%
