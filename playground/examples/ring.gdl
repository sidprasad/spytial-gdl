S0 -> S1 : next
S1 -> S2 : next
S2 -> S3 : next
S3 -> S4 : next
S4 -> S0 : next

S3 -> S2 : other
S2 -> S1 : other

%% Arrange the five nodes related by the next edge in a ring.
@cyclic(selector=next, direction=clockwise)

%% The "other" edge is currently not constrained, and so is free to be laid out however.
%% However, if you uncomment the constraint below, it will cause an 
%% unsatisfiable layout.
%%% @cyclic(selector=other, direction=clockwise)
